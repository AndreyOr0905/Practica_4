<Window x:Class="WpfApp1.ChangeStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="ChangeStatusWindow" Height="240" Width="400">
    <StackPanel Margin="15">
        <TextBlock x:Name="TicketInfoText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <TextBlock Text="Кто меняет статус:" Margin="0,0,0,4"/>
        <ComboBox x:Name="ChangedByBox" DisplayMemberPath="FullName" SelectedValuePath="Id" Margin="0,0,0,10"/>

        <TextBlock Text="Новый статус:" Margin="0,0,0,4"/>
        <ComboBox x:Name="NewStatusBox" Margin="0,0,0,14"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Width="100" Padding="6" Margin="0,0,8,0" IsDefault="True" Click="Save_Click"/>
            <Button Content="Отмена" Width="90" Padding="6" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
