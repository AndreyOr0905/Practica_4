<Window x:Class="WpfApp1.ReferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="ReferencesWindow" Height="430" Width="680">
    <TabControl Margin="10">
        <TabItem Header="Сотрудники">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid x:Name="EmployeesGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                        <DataGridTextColumn Header="Должность" Binding="{Binding Position}" Width="160"/>
                        <DataGridTextColumn Header="Отдел" Binding="{Binding Department}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBox x:Name="EmpNameBox" Width="170" Margin="0,0,6,0" ToolTip="ФИО"/>
                    <TextBox x:Name="EmpPosBox" Width="130" Margin="0,0,6,0" ToolTip="Должность"/>
                    <TextBox x:Name="EmpDeptBox" Width="120" Margin="0,0,6,0" ToolTip="Отдел"/>
                    <Button Content="Добавить" Padding="10,4" Margin="0,0,8,0" Click="AddEmployee_Click"/>
                    <Button Content="Удалить (Soft)" Padding="10,4" Click="DeleteEmployee_Click"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem Header="Оборудование">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid x:Name="EquipmentGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Инв. номер" Binding="{Binding InventoryNumber}" Width="110"/>
                        <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Отдел" Binding="{Binding Department}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBox x:Name="EqInvBox" Width="110" Margin="0,0,6,0" ToolTip="Инв. номер"/>
                    <TextBox x:Name="EqNameBox" Width="190" Margin="0,0,6,0" ToolTip="Название"/>
                    <TextBox x:Name="EqDeptBox" Width="120" Margin="0,0,6,0" ToolTip="Отдел"/>
                    <Button Content="Добавить" Padding="10,4" Margin="0,0,8,0" Click="AddEquipment_Click"/>
                    <Button Content="Удалить (Soft)" Padding="10,4" Click="DeleteEquipment_Click"/>
                </StackPanel>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
