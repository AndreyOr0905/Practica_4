<Window x:Class="WpfApp1.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="ReportsWindow" Height="420" Width="620">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Сводный отчёт по заявкам и SLA" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <TextBox x:Name="ReportTextBox" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="13" Padding="8" TextWrapping="Wrap"/>
        <Button Grid.Row="2" Content="Закрыть" Width="90" Padding="6" HorizontalAlignment="Right" Margin="0,12,0,0" IsCancel="True"/>
    </Grid>
</Window>
