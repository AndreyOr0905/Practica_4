<Window x:Class="WpfApp1.CreateTicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="CreateTicketWindow" Height="390" Width="440">
    <StackPanel Margin="15">
        <TextBlock Text="Автор заявки:" Margin="0,0,0,4"/>
        <ComboBox x:Name="AuthorBox" DisplayMemberPath="FullName" SelectedValuePath="Id" Margin="0,0,0,10"/>

        <TextBlock Text="Оборудование:" Margin="0,0,0,4"/>
        <ComboBox x:Name="EquipmentBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,10"/>

        <TextBlock Text="Приоритет:" Margin="0,0,0,4"/>
        <ComboBox x:Name="PriorityBox" Margin="0,0,0,10"/>

        <TextBlock Text="Заголовок (до 200 символов):" Margin="0,0,0,4"/>
        <TextBox x:Name="TitleBox" MaxLength="200" Margin="0,0,0,10"/>

        <TextBlock Text="Описание неисправности (до 2000 символов):" Margin="0,0,0,4"/>
        <TextBox x:Name="DescriptionBox" Height="75" TextWrapping="Wrap" AcceptsReturn="True" MaxLength="2000" Margin="0,0,0,14"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Создать" Width="100" Padding="6" Margin="0,0,8,0" IsDefault="True" Click="Save_Click"/>
            <Button Content="Отмена" Width="90" Padding="6" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
