<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="HelpDesk" Height="620" Width="1050">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Журнал заявок на ремонт оборудования" 
                   FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <!-- Панель фильтров -->
        <Border Grid.Row="1" BorderBrush="#DCDCDC" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10" Background="#F9F9F9">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Статус:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="StatusFilterBox" Width="120" Margin="0,0,12,0" SelectionChanged="Filter_Changed"/>

                <TextBlock Text="Приоритет:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="PriorityFilterBox" Width="110" Margin="0,0,12,0" SelectionChanged="Filter_Changed"/>

                <TextBlock Text="Исполнитель:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="AssigneeFilterBox" Width="170" DisplayMemberPath="FullName" SelectedValuePath="Id" Margin="0,0,12,0" SelectionChanged="Filter_Changed"/>

                <TextBlock Text="С:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <DatePicker x:Name="DateFromPicker" Width="115" Margin="0,0,8,0" SelectedDateChanged="Filter_Changed"/>

                <TextBlock Text="По:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <DatePicker x:Name="DateToPicker" Width="115" Margin="0,0,12,0" SelectedDateChanged="Filter_Changed"/>

                <Button Content="Сбросить" Padding="10,4" Margin="0,0,6,0" Click="ResetFilters_Click"/>
                <Button Content="Обновить" Padding="10,4" Click="Refresh_Click"/>
            </WrapPanel>
        </Border>

        <!-- Таблица заявок -->
        <DataGrid x:Name="TicketsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#FAFAFA" RowHeight="28">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Заголовок" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" Width="95"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="105"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding AuthorName}" Width="150"/>
                <DataGridTextColumn Header="Оборудование" Binding="{Binding EquipmentName}" Width="160"/>
                <DataGridTextColumn Header="Исполнитель" Binding="{Binding AssigneeName}" Width="150"/>
                <DataGridTextColumn Header="Создана" Binding="{Binding CreatedAtText}" Width="120"/>
                <DataGridTextColumn Header="SLA дедлайн" Binding="{Binding SlaDeadlineText}" Width="120"/>
                <DataGridTextColumn Header="Просрочка" Binding="{Binding OverdueText}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Нижняя панель кнопок -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="+ Создать заявку" Padding="12,6" Margin="0,0,8,0" FontWeight="SemiBold" Click="CreateTicket_Click"/>
            <Button Content="Назначить исполнителя" Padding="12,6" Margin="0,0,8,0" Click="AssignExecutor_Click"/>
            <Button Content="Изменить статус" Padding="12,6" Margin="0,0,8,0" Click="ChangeStatus_Click"/>
            <Button Content="Отчёты и SLA" Padding="12,6" Margin="0,0,8,0" Click="Reports_Click"/>
            <Button Content="Справочники" Padding="12,6" Click="References_Click"/>
        </StackPanel>
    </Grid>
</Window>
